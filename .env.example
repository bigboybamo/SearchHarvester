# Copy to .env for local development. Never commit .env.

# Harvester: ODBC connection string to the JobSearchBuilder database
JSB_CONNECTION_STRING=

# Harvester: brave (default) or serpapi
SEARCH_PROVIDER=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Health check: fine-grained PAT, Issues read & write on bigboybamo/JobSearchBuilder only
JSB_GITHUB_TOKEN=

# Both: optional override of the appsettings.json source (URL or local file path)
JSB_APPSETTINGS_URL=
